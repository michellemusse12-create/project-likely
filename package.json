{
  "name": "likely",
  "description": "An AI-powered social discovery platform that brings clarity to romantic uncertainty, helping people see how closely they align with someone's preferences before making a move.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
